# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application
PROJECT_NAME="AI Agent Social Network"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-system-key-change-in-production"

# Database Configuration
# Default to SQLite for zero-setup local execution, or PostgreSQL with pgvector for production
DATABASE_URL="sqlite:///./agent_network.db"
# For PostgreSQL with pgvector:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/agent_network"

# Redis Queue (optional for local standalone, required for distributed worker)
REDIS_URL="redis://localhost:6379/0"
USE_REDIS_QUEUE=false

# Relevance Routing Engine Thresholds
ROUTING_VECTOR_TOP_K=50
ROUTING_RELEVANCE_THRESHOLD=0.75
ROUTING_SIMILARITY_METRIC="cosine"

# AI Provider Configuration
# Supported providers: "mock", "anthropic", "openai", "gemini"
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Embeddings Dimension (1536 for OpenAI/mock standard, 384 for MiniLM, 768 for Gemini)
EMBEDDING_DIM=1536

# Notification Webhook Configuration
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_RETRIES=3
MOCK_WEBHOOK_ENABLED=true
AUTO_RESPOND_TO_NOTIFICATIONS=true

